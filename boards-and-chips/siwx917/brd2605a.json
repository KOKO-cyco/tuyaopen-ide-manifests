      {
        "id": "audio",
        "name": {
          "en": "Audio (codec-less I2S)",
          "zh-CN": "音频（无编解码器 I2S）"
        },
        "interface": "I2S",
        "mounting": "onboard",
        "pinLocked": true,
        "pins": {
          "I2S": [
            {
              "role": "bck",
              "gpio": 25
            },
            {
              "role": "ws",
              "gpio": 26
            },
            {
              "role": "din",
              "gpio": 27
            },
            {
              "role": "dout",
              "gpio": 28
            },
            {
              "role": "mic_en",
              "gpio": 0,
              "activeLevel": "high"
            }
          ]
        },
        "kconfig": null,
        "note": {
          "en": "16kHz/16kHz codec-less audio via SiWx917 on-chip I2S0. mic_en (GPIO0) enables the microphone bias and is only wired on BRD2605A, not on SIWX917_AI_DEV_KIT.",
          "zh-CN": "通过 SiWx917 片上 I2S0 实现的 16kHz/16kHz 无编解码器音频。mic_en（GPIO0）为麦克风偏置使能脚，仅 BRD2605A 接了这根线，SIWX917_AI_DEV_KIT 没有。"
        }
      }
    ]
